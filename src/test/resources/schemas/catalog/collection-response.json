{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "type": "object",
  "required": ["status", "count", "products"],
  "properties": {
    "status": {"type": "string"},
    "count": {"type": "integer"},
    "products": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "available", "variants"],
        "properties": {
          "id": {"type": "integer"},
          "title": {"type": "string"},
          "available": {"type": "boolean"},
          "variants": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "product_id", "available"],
              "properties": {
                "id": {"type": "integer"},
                "product_id": {"type": "integer"},
                "available": {"type": "boolean"},
                "quantity": {"type": ["integer", "null"]}
              }
            }
          }
        }
      }
    }
  }
}
